{
  "name": "rep-raiders",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "maps:build": "tsx scripts/buildMaps.ts",
    "workouts:sheet": "tsx scripts/buildWorkoutSheet.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
        ],
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ]
      },
      {
        "displayName": "rpg",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/rpg/**/__tests__/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": "babel-jest"
        }
      }
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/teko": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
